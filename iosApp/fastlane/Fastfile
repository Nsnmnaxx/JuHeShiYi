default_platform(:ios)

platform :ios do
  lane :build do |options|
    device_udid = options[:device_udid] || ENV['DEVICE_UDID']
    apple_id   = options[:apple_id]   || ENV['APPLE_ID']

    unless device_udid && apple_id
      UI.user_error!("DEVICE_UDID and APPLE_ID are required")
    end

    UI.message("Free Apple ID → Xcode automatic signing")

    # 免费 Apple ID 先用 security 写入钥匙串，再走 xcodebuild 自动签名
    build_app(
      project: 'iosApp.xcodeproj',
      scheme: 'iosApp',
      configuration: 'Release',
      export_method: 'development',
      output_directory: '../build',
      output_name: 'iosApp.ipa',
      xcargs: '-allowProvisioningUpdates',
    )
  end
end
