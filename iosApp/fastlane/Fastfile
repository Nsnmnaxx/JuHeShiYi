default_platform(:ios)

platform :ios do
  lane :build do |options|
    device_udid = options[:device_udid] || ENV['DEVICE_UDID']
    apple_id   = options[:apple_id]   || ENV['APPLE_ID']

    unless device_udid && apple_id
      UI.user_error!("DEVICE_UDID and APPLE_ID are required")
    end

    app_specific_password = ENV['FASTLANE_APP_SPECIFIC_PASSWORD'] || ''

    UI.message("Free Apple ID → Xcode automatic signing")

    # 免费 Apple ID 只能用 Xcode 自动签名，不能走 cert/register_device/sigh API
    build_app(
      project: 'iosApp.xcodeproj',
      scheme: 'iosApp',
      configuration: 'Release',
      export_method: 'development',
      output_directory: '../build',
      output_name: 'iosApp.ipa',
      xcargs: "-allowProvisioningUpdates -authenticationAppleID #{apple_id} -authenticationPassword #{app_specific_password}",
    )
  end
end
